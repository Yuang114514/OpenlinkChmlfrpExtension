{
  "schema_version": 1,
  "quilt_loader": {
    "group": "${group}",
    "id": "openlink_chmlfrp_extension",
    "version": "${version}",
    "metadata": {
      "name": "OpenLink Chmlfrp Extension",
      "description": "An OpenLink addon for Chmlfrp.",
      "contributors": {
        "Yuang2714": "Author"
      },
      "icon": "assets/openlink_chmlfrp_extension/icon.png"
    },
    "intermediate_mappings": "net.fabricmc:intermediary",
